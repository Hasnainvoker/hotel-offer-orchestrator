# Defaults shown; every variable is optional for local development.
PORT=3000
LOG_LEVEL=info
# Enables PUT /admin/suppliers/:id to simulate supplier outages (demo/test only)
ENABLE_ADMIN_ROUTES=false

REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=600

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers

# Defaults to the mock endpoints served by this API.
SUPPLIER_A_URL=http://localhost:3000/supplierA/hotels
SUPPLIER_B_URL=http://localhost:3000/supplierB/hotels
SUPPLIER_TIMEOUT_MS=3000
