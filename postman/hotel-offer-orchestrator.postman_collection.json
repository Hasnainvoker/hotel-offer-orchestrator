    {
      "name": "Simulate supplier down",
      "description": "Run in order. Each scenario takes a supplier down via the admin endpoint and restores it at the end.",
      "item": [
        {
          "name": "1. Take Supplier B down",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"up\": false }"
            },
            "url": "{{baseUrl}}/admin/suppliers/supplierB"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('supplierB marked down', () => pm.expect(pm.response.json().supplierB).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Supplier B endpoint returns 503",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/supplierB/hotels?city=delhi"
          },
          "event": [
