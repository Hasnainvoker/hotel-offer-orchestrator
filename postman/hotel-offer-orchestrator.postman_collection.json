    {
      "name": "Hotels",
      "item": [
        {
          "name": "Valid city with overlaps (delhi)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"response shape is [{ name, price, supplier, commissionPct }]\", () => body.forEach(h => pm.expect(h).to.have.all.keys(\"name\", \"price\", \"supplier\", \"commissionPct\")));",
                  "const byName = Object.fromEntries(body.map(h => [h.name, h]));",
                  "pm.test('hotel names are unique (de-duplicated)', () => pm.expect(new Set(body.map(h => h.name)).size).to.eql(body.length));",
                  "pm.test('8 unique delhi hotels', () => pm.expect(body.length).to.eql(8));",
                  "pm.test('Holtin: Supplier B is cheaper (5340)', () => pm.expect(byName['Holtin']).to.eql({ name: 'Holtin', price: 5340, supplier: 'Supplier B', commissionPct: 20 }));",
                  "pm.test('Radison: Supplier A is cheaper (5900)', () => pm.expect(byName['Radison']).to.eql({ name: 'Radison', price: 5900, supplier: 'Supplier A', commissionPct: 13 }));",
                  "pm.test('hotel only at Supplier A is kept (ITC Maurya)', () => pm.expect(byName['ITC Maurya'].supplier).to.eql('Supplier A'));",
                  "pm.test('hotel only at Supplier B is kept (Novotel)', () => pm.expect(byName['Novotel'].supplier).to.eql('Supplier B'));",
                  "pm.test('sorted by price ascending', () => body.slice(1).forEach((h, i) => pm.expect(h.price).to.be.at.least(body[i].price)));",
                  "pm.test('not a partial result', () => pm.expect(pm.response.headers.has('X-Partial-Results')).to.be.false);"
                ]
              }
            }
          ]
        },
