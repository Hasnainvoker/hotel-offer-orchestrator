              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status degraded', () => pm.expect(body.status).to.eql('degraded'));",
                  "pm.test('supplierB down, supplierA up', () => {",
                  "  pm.expect(body.suppliers.supplierB.status).to.eql('down');",
                  "  pm.expect(body.suppliers.supplierA.status).to.eql('up');",
