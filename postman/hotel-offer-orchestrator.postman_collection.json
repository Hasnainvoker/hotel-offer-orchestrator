  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check (suppliers + dependencies)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status is ok', () => pm.expect(body.status).to.eql('ok'));",
                  "pm.test('both suppliers are up', () => {",
                  "  pm.expect(body.suppliers.supplierA.status).to.eql('up');",
                  "  pm.expect(body.suppliers.supplierB.status).to.eql('up');",
                  "});",
                  "pm.test('redis and temporal are up', () => {",
                  "  pm.expect(body.dependencies.redis.status).to.eql('up');",
                  "  pm.expect(body.dependencies.temporal.status).to.eql('up');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
